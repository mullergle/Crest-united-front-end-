                                        Card details shown here are
                                        for testing purposes only.
                                    </div>
                                </div>
                                <div class="flip-hint">
                                    Tap card to flip back
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
                <!-- =================================================
                     MONTHLY BUDGET
                ================================================= -->
                <section id="analytics">
                    <div class="section-header">
                        <h2>
                            Monthly Budget
                        </h2>
                        <span class="view-all">
                            September
                        </span>
                    </div>
                    <div class="spending-card">
                        <div class="stat-label">
                            Total spending
                        </div>
                        <div class="spending-total">
                            $3,482.18
                        </div>
                        <div class="progress">
                            <span></span>
                        </div>
                        <div class="spending-row">
                            <span>
                                Used
                            </span>
                            <strong>
                                64%
                            </strong>
                        </div>
                        <div class="spending-row">
                            <span>
                                Monthly limit
                            </span>
                            <strong>
                                $5,400
                            </strong>
                        </div>
                    </div>
                </section>
                <!-- INVISIBLE NAVIGATION ANCHORS -->
                <div id="transfer-section"
                     class="hidden-section">
                </div>
                <div id="payments-section"
                     class="hidden-section">
                </div>
                <div id="savings"
                     class="hidden-section">
                </div>
                <div id="profile"
                     class="hidden-section">
                </div>
                <div id="settings"
                     class="hidden-section">
                </div>
            </div>
        </div>
    </div>
</main>
</div>
<script>
/* =========================================================
   MOBILE SIDEBAR
========================================================= */
const sidebar =
    document.getElementById("sidebar");
const sidebarOverlay =
    document.getElementById("sidebarOverlay");
const pageTitle =
    document.getElementById("pageTitle");
function openSidebar(){
    sidebar.classList.add("open");
    sidebarOverlay.classList.add("show");
    document.body.style.overflow = "hidden";
}
function closeSidebar(){
    sidebar.classList.remove("open");
    sidebarOverlay.classList.remove("show");
    document.body.style.overflow = "";
}
/* =========================================================
   PAGE TITLES
========================================================= */
const pageTitles = {
    dashboard:
        "Dashboard",
    transactions:
        "Transactions",
    cards:
        "Cards",
    analytics:
        "Analytics",
    transfer:
        "Transfer Money",
    payments:
        "Payments",
    savings:
        "Savings",
    profile:
        "Profile",
    settings:
        "Settings"
};
/* =========================================================
   NAVIGATION
========================================================= */
document
.querySelectorAll(".side-nav a[data-page]")
.forEach(link => {
    link.addEventListener(
        "click",
        function(event){
            event.preventDefault();
            const page =
                this.dataset.page;
            document
            .querySelectorAll(".side-nav a")
            .forEach(item => {
                item.classList.remove("active");
            });
            this.classList.add("active");
            if(pageTitle && pageTitles[page]){
                pageTitle.textContent =
                    pageTitles[page];
            }
            const targetMap = {
                dashboard:
                    "dashboard",
                transactions:
                    "transactions",
                cards:
                    "cards",
                analytics:
                    "analytics",
                transfer:
                    "transfer-section",
                payments:
                    "payments-section",
                savings:
                    "savings",
                profile:
                    "profile",
                settings:
                    "settings"
            };
            const target =
                document.getElementById(
                    targetMap[page]
                );
            if(target){
                target.scrollIntoView({
                    behavior:"smooth",
                    block:
                        page === "dashboard"
                            ? "start"
                            : "center"
                });
            }
            if(window.innerWidth <= 760){
                closeSidebar();
            }
        }
    );
});
/* =========================================================
   BRAND → DASHBOARD
========================================================= */
function showDashboard(event){
    event.preventDefault();
    document
    .querySelectorAll(".side-nav a")
    .forEach(item => {
        item.classList.remove("active");
    });
    const dashboardLink =
        document.querySelector(
            '.side-nav a[data-page="dashboard"]'
        );
    if(dashboardLink){
        dashboardLink.classList.add("active");
    }
    pageTitle.textContent =
        "Dashboard";
    document
    .getElementById("dashboard")
    .scrollIntoView({
        behavior:"smooth",
        block:"start"
    });
    if(window.innerWidth <= 760){
        closeSidebar();
    }
}
/* =========================================================
   BALANCE CARD TRANSFER / PAY BUTTONS
========================================================= */
document
.querySelectorAll(".action-btn[data-action]")
.forEach(button => {
    button.addEventListener(
        "click",
        function(){
            const action =
                this.dataset.action;
            if(action === "transfer"){
                pageTitle.textContent =
                    "Transfer Money";
                const section =
                    document.getElementById(
                        "transfer-section"
                    );
                if(section){
                    section.scrollIntoView({
                        behavior:"smooth",
                        block:"center"
                    });
                }
            }
            if(action === "payments"){
                pageTitle.textContent =
                    "Payments";
                const section =
                    document.getElementById(
                        "payments-section"
                    );
                if(section){
                    section.scrollIntoView({
                        behavior:"smooth",
                        block:"center"
                    });
                }
            }
        }
    );
});
/* =========================================================
   CARD FLIP
========================================================= */
const bankCard =
    document.getElementById("bankCard");
if(bankCard){
    bankCard.addEventListener(
        "click",
        function(){
            this.classList.toggle("flipped");
            this.setAttribute(
                "aria-label",
                this.classList.contains("flipped")
                    ? "Flip card to view the front"
                    : "Flip card to view the back"
            );
        }
    );
    /*
     * Keyboard support
     */
    bankCard.addEventListener(
        "keydown",
        function(event){
            if(
                event.key === "Enter" ||
                event.key === " "
            ){
                event.preventDefault();
                this.classList.toggle("flipped");
                this.setAttribute(
                    "aria-label",
                    this.classList.contains("flipped")
                        ? "Flip card to view the front"
                        : "Flip card to view the back"
                );
            }
        }
    );
}
/* =========================================================
   ESCAPE KEY
========================================================= */
document.addEventListener(
    "keydown",
    function(event){
        if(event.key === "Escape"){
            closeSidebar();
        }
    }
);
/* =========================================================
   PREVENT ACCIDENTAL DOUBLE-TAP ZOOM
========================================================= */
let lastTouchEnd = 0;
document.addEventListener(
    "touchend",
    function(event){
        const now =
            Date.now();
        if(
            now - lastTouchEnd <= 300
        ){
            event.preventDefault();
        }
        lastTouchEnd = now;
    },
    {
        passive:false
    }
);
/* =========================================================
   CLOSE SIDEBAR IF WINDOW IS RESIZED
========================================================= */
window.addEventListener(
    "resize",
    function(){
        if(window.innerWidth > 760){
            closeSidebar();
        }
    }
);
</script>
</body>
</html>