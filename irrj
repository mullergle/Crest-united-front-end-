<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport"
      content="width=device-width,
               initial-scale=1.0,
               maximum-scale=1.0,
               user-scalable=no,
               viewport-fit=cover">
<title>Capital Crest | Dashboard</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@500;600;700;800&display=swap"
      rel="stylesheet">
<style>
:root{
    --ink:#07151b;
    --deep:#0a2223;
    --deep2:#103536;
    --green:#1e6256;
    --green2:#2c806c;
    --mint:#b8e0ca;
    --cream:#f5f2e8;
    --white:#fff;
    --text:#eef5f1;
    --muted:#8fa39d;
    --gold:#c9a96b;
    --line:rgba(255,255,255,.08);
    --card:rgba(255,255,255,.045);
    --danger:#d98b8b;
    --shadow:0 25px 70px rgba(0,0,0,.22);
}
*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}
html{
    background:#07151b;
    scroll-behavior:smooth;
    -webkit-text-size-adjust:100%;
}
body{
    min-height:100vh;
    min-height:100dvh;
    font-family:"DM Sans",sans-serif;
    color:var(--text);
    background:
        radial-gradient(
            circle at 10% 0%,
            rgba(44,128,108,.13),
            transparent 28%
        ),
        linear-gradient(
            135deg,
            #07151b,
            #092526 55%,
            #0b2929
        );
    overflow-x:hidden;
    -webkit-tap-highlight-color:transparent;
}
a{
    color:inherit;
    text-decoration:none;
}
button,
input,
select,
textarea{
    font-family:inherit;
}
button{
    cursor:pointer;
}
/* =========================================================
   DASHBOARD
========================================================= */
.dashboard{
    min-height:100vh;
    min-height:100dvh;
    display:flex;
}
/* =========================================================
   SIDEBAR
========================================================= */
.sidebar{
    width:245px;
    min-height:100vh;
    min-height:100dvh;
    position:fixed;
    left:0;
    top:0;
    bottom:0;
    z-index:1000;
    display:flex;
    flex-direction:column;
    padding:28px 18px;
    background:rgba(5,18,23,.96);
    border-right:1px solid var(--line);
    backdrop-filter:blur(20px);
    -webkit-backdrop-filter:blur(20px);
    overflow-y:auto;
    overscroll-behavior:contain;
    scrollbar-width:none;
}
.sidebar::-webkit-scrollbar{
    display:none;
}
/* =========================================================
   BRAND
========================================================= */
.brand{
    display:flex;
    align-items:center;
    gap:9px;
    flex-shrink:0;
}
.crest-logo{
    width:34px;
    height:39px;
    position:relative;
    display:flex;
    align-items:center;
    justify-content:center;
}
.crest-shield{
    width:25px;
    height:31px;
    background:
        linear-gradient(
            145deg,
            var(--mint),
            var(--green2)
        );
    clip-path:polygon(
        50% 0%,
        91% 14%,
        87% 61%,
        72% 82%,
        50% 100%,
        28% 82%,
        13% 61%,
        9% 14%
    );
    position:relative;
}
.crest-shield::before{
    content:"";
    position:absolute;
    width:12px;
    height:12px;
    left:50%;
    top:7px;
    transform:
        translateX(-50%)
        rotate(45deg);
    border:1.5px solid rgba(7,21,27,.7);
}
.crest-shield::after{
    content:"C";
    position:absolute;
    left:50%;
    top:11px;
    transform:translateX(-50%);
    font-family:Georgia,serif;
    font-size:9px;
    font-weight:bold;
    color:var(--ink);
}
.brand-text{
    display:flex;
    flex-direction:column;
    line-height:1;
}
.brand-text strong{
    font-family:"Manrope",sans-serif;
    font-size:13px;
    letter-spacing:1.2px;
    font-weight:800;
}
.brand-text span{
    margin-top:4px;
    color:#8fa39d;
    font-size:6px;
    letter-spacing:2.8px;
    font-weight:700;
}
/* =========================================================
   SIDEBAR NAVIGATION
========================================================= */
.side-section{
    margin-top:32px;
    flex-shrink:0;
}
.side-section:first-of-type{
    margin-top:42px;
}
.side-label{
    padding:0 12px;
    margin-bottom:9px;
    color:#506963;
    font-size:8px;
    font-weight:800;
    letter-spacing:1.8px;
    text-transform:uppercase;
}
.side-nav{
    display:flex;
    flex-direction:column;
    gap:3px;
}
.side-nav a{
    width:100%;
    min-height:42px;
    display:flex;
    align-items:center;
    gap:12px;
    padding:0 12px;
    border-radius:10px;
    color:#829792;
    font-size:11px;
    font-weight:600;
    line-height:1;
    transition:
        background .2s ease,
        color .2s ease,
        transform .2s ease;
}
.side-nav a:hover{
    color:var(--mint);
    background:
        rgba(184,224,202,.055);
    transform:translateX(2px);
}
.side-nav a.active{
    color:var(--mint);
    background:
        rgba(184,224,202,.09);
    box-shadow:
        inset 3px 0 0 var(--mint);
}
.side-nav a.active svg{
    color:var(--mint);
}
.side-nav svg{
    width:17px;
    height:17px;
    flex-shrink:0;
    opacity:.9;
}
.side-nav a span{
    display:block;
}
/* =========================================================
   SIDEBAR PROFILE
========================================================= */
.sidebar-bottom{
    margin-top:auto;
    padding-top:25px;
    flex-shrink:0;
}
.profile-mini{
    padding:14px 11px;
    display:flex;
    align-items:center;
    gap:10px;
    border:1px solid var(--line);
    border-radius:12px;
    background:
        rgba(255,255,255,.025);
}
.avatar{
    width:34px;
    height:34px;
    flex-shrink:0;
    display:flex;
    align-items:center;
    justify-content:center;
    border-radius:50%;
    background:
        linear-gradient(
            145deg,
            var(--mint),
            var(--green2)
        );
    color:#09201d;
    font-size:11px;
    font-weight:800;
}
.profile-info{
    min-width:0;
}
.profile-info strong{
    display:block;
    overflow:hidden;
    text-overflow:ellipsis;
    white-space:nowrap;
    font-size:10px;
}
.profile-info span{
    display:block;
    margin-top:3px;
    color:#61756f;
    font-size:8px;
}
/* =========================================================
   MAIN
========================================================= */
.main{
    width:calc(100% - 245px);
    margin-left:245px;
    min-height:100vh;
    min-height:100dvh;
}
/* =========================================================
   TOPBAR
========================================================= */
.topbar{
    height:76px;
    position:sticky;
    top:0;
    z-index:500;
    display:flex;
    align-items:center;
    justify-content:space-between;
    padding:0 38px;
    border-bottom:1px solid var(--line);
    background:
        rgba(7,21,27,.76);
    backdrop-filter:blur(18px);
    -webkit-backdrop-filter:blur(18px);
}
.topbar-left{
    display:flex;
    align-items:center;
    gap:14px;
}
.mobile-menu{
    display:none;
    width:38px;
    height:38px;
    border:1px solid var(--line);
    border-radius:9px;
    background:
        rgba(255,255,255,.04);
    color:white;
    align-items:center;
    justify-content:center;
}
.page-title{
    font-family:"Manrope",sans-serif;
    font-size:18px;
    font-weight:700;
}
.page-subtitle{
    margin-top:3px;
    color:#687e77;
    font-size:9px;
}
.topbar-right{
    display:flex;
    align-items:center;
    gap:10px;
}
.icon-button{
    width:38px;
    height:38px;
    border:1px solid var(--line);
    border-radius:10px;
    background:
        rgba(255,255,255,.025);
    color:#9aada7;
    display:flex;
    align-items:center;
    justify-content:center;
}
.icon-button:hover{
    color:var(--mint);
    border-color:
        rgba(184,224,202,.2);
}
.icon-button svg{
    width:17px;
}
/* =========================================================
   CONTENT
========================================================= */
.content{
    width:min(1280px,94%);
    margin:auto;
    padding:34px 0 60px;
}
/* =========================================================
   WELCOME
========================================================= */
.welcome{
    display:flex;
    justify-content:space-between;
    align-items:flex-end;
    margin-bottom:27px;
}
.welcome-kicker{
    color:var(--mint);
    font-size:9px;
    font-weight:800;
    letter-spacing:2px;
    text-transform:uppercase;
    margin-bottom:8px;
}
.welcome h1{
    font-family:"Manrope",sans-serif;
    font-size:
        clamp(25px,3vw,37px);
    line-height:1.1;
    letter-spacing:-1px;
}
.welcome p{
    margin-top:7px;
    color:#778d87;
    font-size:10px;
}
/* =========================================================
   OVERVIEW
========================================================= */
.overview-grid{
    display:grid;
    grid-template-columns:
        1.35fr .65fr;
    gap:16px;
}
/* =========================================================
   BALANCE CARD
========================================================= */
.balance-card{
    min-height:260px;
    position:relative;
    overflow:hidden;
    padding:29px;
    border-radius:21px;
    border:
        1px solid
        rgba(184,224,202,.14);
    background:
        radial-gradient(
            circle at 90% 0%,
            rgba(184,224,202,.15),
            transparent 35%
        ),
        linear-gradient(
            135deg,
            #123937,
            #0b2929 58%,
            #082020
        );
    box-shadow:var(--shadow);
}
.balance-card::before{
    content:"";
    position:absolute;
    width:270px;
    height:270px;
    right:-105px;
    bottom:-155px;
    border:
        1px solid
        rgba(184,224,202,.11);
    border-radius:50%;
}
.balance-card::after{
    content:"";
    position:absolute;
    width:190px;
    height:190px;
    right:-55px;
    bottom:-105px;
    border:
        1px solid
        rgba(201,169,107,.10);
    border-radius:50%;
}
.balance-top{
    display:flex;
    align-items:center;
    justify-content:space-between;
}
.account-type{
    color:#91a7a1;
    font-size:9px;
    text-transform:uppercase;
    letter-spacing:1.6px;
}
.status{
    display:flex;
    align-items:center;
    gap:6px;
    padding:6px 9px;
    border-radius:30px;
    background:
        rgba(184,224,202,.07);
    color:var(--mint);
    font-size:8px;
    font-weight:700;
}
.status-dot{
    width:5px;
    height:5px;
    border-radius:50%;
    background:var(--mint);
    box-shadow:
        0 0 10px
        rgba(184,224,202,.7);
}
.balance-label{
    margin-top:43px;
    color:#829993;
    font-size:9px;
    text-transform:uppercase;
    letter-spacing:1.5px;
}
.balance-amount{
    margin-top:6px;
    font-family:"Manrope",sans-serif;
    font-size:
        clamp(29px,4vw,43px);
    font-weight:700;
    letter-spacing:-1.5px;
}
.balance-meta{
    margin-top:8px;
    display:flex;
    align-items:center;
    gap:8px;
}
.balance-meta span{
    color:#6f8881;
    font-size:9px;
}
.balance-meta strong{
    color:var(--mint);
    font-size:9px;
}
.balance-actions{
    position:absolute;
    left:29px;
    bottom:25px;
    display:flex;
    gap:8px;
}
.action-btn{
    display:flex;
    align-items:center;
    gap:7px;
    padding:10px 13px;
    border-radius:8px;
    border:
        1px solid
        rgba(255,255,255,.11);
    background:
        rgba(255,255,255,.045);
    color:#dbe6e2;
    font-size:9px;
    font-weight:700;
    transition:.2s ease;
}
.action-btn:hover{
    background:
        rgba(184,224,202,.08);
    color:var(--mint);
}
.action-btn svg{
    width:13px;
}
/* =========================================================
   QUICK STATS
========================================================= */
.quick-stats{
    display:grid;
    gap:16px;
}
.stat-card{
    min-height:122px;
    padding:22px;
    border:
        1px solid
        var(--line);
    border-radius:18px;
    background:
        rgba(255,255,255,.035);
}
.stat-head{
    display:flex;
    justify-content:space-between;
    align-items:center;
}
.stat-label{
    color:#718780;
    font-size:9px;
    text-transform:uppercase;
    letter-spacing:1.3px;
}
.stat-icon{
    width:31px;
    height:31px;
    display:flex;
    align-items:center;
    justify-content:center;
    border-radius:9px;
    background:
        rgba(184,224,202,.06);
    color:var(--mint);
}
.stat-icon svg{
    width:15px;
}
.stat-value{
    margin-top:13px;
    font-family:"Manrope",sans-serif;
    font-size:21px;
    font-weight:700;
}
.stat-change{
    margin-top:4px;
    color:#6e8880;
    font-size:8px;
}
.stat-change.positive{
    color:var(--mint);
}
/* =========================================================
   SECTION HEADER
========================================================= */
.section-header{
    margin-top:35px;
    margin-bottom:15px;
    display:flex;
    align-items:center;
    justify-content:space-between;
}
.section-header h2{
    font-family:"Manrope",sans-serif;
    font-size:16px;
}
.view-all{
    color:var(--mint);
    font-size:9px;
    font-weight:700;
}
/* =========================================================
   LOWER GRID
========================================================= */
.dashboard-grid{
    display:grid;
    grid-template-columns:
        1.35fr .65fr;
    gap:16px;
}
/* =========================================================
   TRANSACTIONS
========================================================= */
.transactions{
    border:
        1px solid
        var(--line);
    border-radius:18px;
    background:
        rgba(255,255,255,.032);
    overflow:hidden;
}
.transaction{
    display:flex;
    align-items:center;
    padding:16px 19px;
    border-bottom:
        1px solid
        rgba(255,255,255,.055);
}
.transaction:last-child{
    border-bottom:none;
}
.transaction-icon{
    width:38px;
    height:38px;
    margin-right:12px;
    display:flex;
    align-items:center;
    justify-content:center;
    border-radius:11px;
    background:
        rgba(184,224,202,.055);
    color:#a7cbbb;
}
.transaction-icon svg{
    width:16px;
}
.transaction-main{
    flex:1;
    min-width:0;
}
.transaction-main strong{
    display:block;
    font-size:10px;
    font-weight:700;
}
.transaction-main span{
    display:block;
    margin-top:4px;
    color:#637972;
    font-size:8px;
}
.transaction-amount{
    text-align:right;
}
.transaction-amount strong{
    display:block;
    font-size:10px;
}
.transaction-amount span{
    display:block;
    margin-top:4px;
    color:#657a74;
    font-size:8px;
}
.income{
    color:var(--mint);
}
.expense{
    color:#d8e0dd;
}
/* =========================================================
   BANK CARD — FLIP CONTAINER
========================================================= */
.card-flip{
    width:100%;
    min-height:252px;
    perspective:1200px;
    cursor:pointer;
    -webkit-tap-highlight-color:transparent;
    outline:none;
}
.bank-card{
    width:100%;
    min-height:252px;
    position:relative;
    transform-style:preserve-3d;
    transition:
        transform .7s cubic-bezier(.2,.75,.25,1);
    border-radius:18px;
    box-shadow:var(--shadow);
}
.card-flip.flipped .bank-card{
    transform:rotateY(180deg);
}
/* =========================================================
   CARD FACES
========================================================= */
.card-face{
    position:absolute;
    inset:0;
    width:100%;
    min-height:252px;
    border-radius:18px;
    overflow:hidden;
    backface-visibility:hidden;
    -webkit-backface-visibility:hidden;
    background:
        linear-gradient(
            145deg,
            #1b5e52,
            #103b38 58%,
            #092625
        );
    border:
        1px solid
        rgba(184,224,202,.15);
}
.card-face::before{
    content:"";
    position:absolute;
    width:220px;
    height:220px;
    right:-80px;
    top:-120px;
    border-radius:50%;
    border:
        1px solid
        rgba(255,255,255,.09);
    pointer-events:none;
}
.card-front{
    transform:rotateY(0deg);
    padding:24px;
}
.card-back{
    transform:rotateY(180deg);
    padding:0;
    background:
        linear-gradient(
            145deg,
            #174d46,
            #0d3533 60%,
            #082323
        );
}
/* =========================================================
   FRONT OF CARD
========================================================= */
.bank-card-top{
    display:flex;
    justify-content:space-between;
    align-items:center;
    position:relative;
    z-index:2;
}
.card-title{
    font-size:9px;
    letter-spacing:1.4px;
    text-transform:uppercase;
    color:#b4ccc4;
}
.contactless{
    width:19px;
    height:19px;
    opacity:.8;
}
.card-number{
    margin-top:54px;
    font-family:"Manrope",sans-serif;
    font-size:17px;
    letter-spacing:3px;
    position:relative;
    z-index:2;
}
.card-details{
    margin-top:22px;
    display:flex;
    justify-content:space-between;
    position:relative;
    z-index:2;
}
.card-details small{
    display:block;
    color:#77978e;
    font-size:6px;
    text-transform:uppercase;
    letter-spacing:1px;
}
.card-details strong{
    display:block;
    margin-top:4px;
    font-size:8px;
}
.card-chip{
    width:35px;
    height:26px;
    margin-top:19px;
    border-radius:6px;
    background:
        linear-gradient(
            135deg,
            #d8c58e,
            #a98c52
        );
    position:relative;
    z-index:2;
}
.card-chip::before,
.card-chip::after{
    content:"";
    position:absolute;
    background:
        rgba(65,54,30,.35);
}
.card-chip::before{
    width:1px;
    height:100%;
    left:50%;
}
.card-chip::after{
    height:1px;
    width:100%;
    top:50%;
}
/* =========================================================
   BACK OF CARD
========================================================= */
.card-back{
    display:flex;
    flex-direction:column;
}
/* Magnetic stripe */
.magnetic-stripe{
    width:100%;
    height:48px;
    margin-top:27px;
    background:
        linear-gradient(
            90deg,
            #050b0c,
            #182020,
            #050b0c
        );
}
/* Back information */
.back-content{
    padding:17px 24px 20px;
    position:relative;
    z-index:2;
}
.signature-label{
    color:#77978e;
    font-size:6px;
    text-transform:uppercase;
    letter-spacing:1px;
    margin-bottom:5px;
}
.signature-row{
    display:flex;
    align-items:center;
    gap:8px;
}
.signature-panel{
    height:29px;
    flex:1;
    display:flex;
    align-items:center;
    padding:0 10px;
    border-radius:3px;
    background:#e7e5d8;
    color:#34403d;
    font-family:Georgia,serif;
    font-size:8px;
    font-style:italic;
}
.cvv-box{
    width:48px;
    height:29px;
    display:flex;
    align-items:center;
    justify-content:center;
    border-radius:3px;
    background:#f5f3e9;
    color:#111;
    font-family:"Manrope",sans-serif;
    font-size:9px;
    font-weight:800;
    letter-spacing:1px;
}
.back-info{
    margin-top:15px;
    display:grid;
    grid-template-columns:
        1fr 1fr;
    gap:8px 20px;
}
.back-info small{
    display:block;
    color:#77978e;
    font-size:6px;
    text-transform:uppercase;
    letter-spacing:1px;
}
.back-info strong{
    display:block;
    margin-top:3px;
    color:#dbe6e2;
    font-size:8px;
}
.card-back-note{
    margin-top:11px;
    color:#6f8881;
    font-size:6px;
    line-height:1.5;
}
/* Flip hint */
.flip-hint{
    position:absolute;
    right:18px;
    bottom:14px;
    color:rgba(220,240,232,.5);
    font-size:6px;
    letter-spacing:.7px;
    text-transform:uppercase;
    z-index:5;
    pointer-events:none;
}
/* =========================================================
   SPENDING
========================================================= */
.spending-card{
    padding:23px;
    border:
        1px solid
        var(--line);
    border-radius:18px;
    background:
        rgba(255,255,255,.032);
}
.spending-total{
    margin-top:8px;
    font-family:"Manrope",sans-serif;
    font-size:24px;
    font-weight:700;
}
.progress{
    height:7px;
    margin-top:18px;
    border-radius:20px;
    overflow:hidden;
    background:
        rgba(255,255,255,.07);
}
.progress span{
    display:block;
    width:64%;
    height:100%;
    border-radius:20px;
    background:
        linear-gradient(
            90deg,
            var(--green2),
            var(--mint)
        );
}
